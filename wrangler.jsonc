{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Uygulama (web/) ve API aynı Worker'da, aynı adreste çalışır.
  "name": "gun-payi-telegram",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/telegram/*", "/health"]
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HUB",
        "class_name": "ReminderHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ReminderHub"
      ]
    }
  ],
  "observability": {
    "enabled": false
  },
  "ratelimits": [
    {
      "name": "SETUP_LIMITER",
      "namespace_id": "164208410",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
